# Optional override. The default is the small LLMLingua-2 BERT checkpoint.
COMPRESSOR_MODEL=microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank

# Keep at least this fraction of tokens even when aggressiveness is 1.0.
COMPRESSOR_MIN_RATE=0.45

# Use cpu for the default Docker deployment. Set to cuda only with a CUDA PyTorch image.
COMPRESSOR_DEVICE=cpu

# UsageTap checks every compression operation before compression begins.
USAGETAP_API_BASE_URL=https://api.usagetap.com
USAGETAP_AUTHORIZATION_TIMEOUT_SECONDS=3
USAGETAP_COMPRESSION_KEY_MIN_SUFFIX_LENGTH=43
USAGETAP_COMPRESSION_KEY_MAX_SUFFIX_LENGTH=43
USAGETAP_AUTHORIZATION_FAILURE_CACHE_SECONDS=5

# Cloud Run injects this value from Secret Manager. Never commit a real key.
USAGETAP_METERING_API_KEY=
USAGETAP_METERING_TIMEOUT_SECONDS=3

# Bounded response cache stored in each Cloud Run container's Python process.
# Entries are ephemeral, isolated per instance, and cleared on restart/scale-to-zero.
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_MAX_BYTES=33554432
RESPONSE_CACHE_MAX_ENTRY_BYTES=1048576
RESPONSE_CACHE_MAX_ENTRIES=4096
RESPONSE_CACHE_TTL_SECONDS=300
RESPONSE_CACHE_SINGLE_FLIGHT_TIMEOUT_SECONDS=30

# Optional, short-lived UI demo mode. Keep disabled outside controlled demos.
# The signing key must be at least 32 random bytes and come from Secret Manager.
USAGETAP_DEMO_MODE_ENABLED=false
USAGETAP_DEMO_SIGNING_KEY=
USAGETAP_DEMO_MODE_EXPIRES_AT=
USAGETAP_DEMO_SESSION_TTL_SECONDS=600
USAGETAP_DEMO_MAX_OPERATIONS_PER_SESSION=5
USAGETAP_DEMO_MAX_INPUT_CHARS_PER_SESSION=50000
USAGETAP_DEMO_MAX_INPUT_CHARS_PER_OPERATION=20000
USAGETAP_DEMO_MAX_ACTIVE_SESSIONS=10
